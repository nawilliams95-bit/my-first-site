# RealtyDataLabs Social Engine — Environment Variables
# Copy this file to .env and fill in all values before running

# OpenAI
OPENAI_API_KEY=sk-...

# Twitter/X API v2 — requires Elevated or Pro access for write permissions
TWITTER_APP_KEY=your_app_key
TWITTER_APP_SECRET=your_app_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Firebase — create a service account in Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
